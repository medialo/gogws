<topic xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd"
       title="Discover %tool_name%" id="Discover-Gogws">

    <section-starting-page>
        <title>Discover %tool_name%</title>
        <description>
            %tool_name% manages a folder full of Git repositories as one workspace. Check the status, fetch, pull
            and clone all of them in parallel, run your own scripts around each command, and keep your defaults in
            one configuration file.
        </description>

        <spotlight>
            <a href="Workspace-file.topic" summary="Describe your projects and sub-workspaces in a workspace file.">Workspace file</a>
            <a href="Use-cases.topic" summary="One example of how to use %tool_name% in a company scenario.">Use cases</a>
        </spotlight>

        <primary>
            <title>Get started</title>
            <a href="Getting-started.topic" summary="Install from sources, with go install, from a release or with Scoop.">Getting started</a>
            <a href="Configuration.topic" summary="Set your defaults in config.yaml or with the config command.">Configuration</a>
            <a href="Completion.topic" summary="Complete commands, flags and flag values in your shell.">Completion</a>
        </primary>

        <secondary>
            <title>Configure your workspace</title>
            <a href="Workspace-file.topic" summary="The recommended YAML, JSON or TOML format.">Workspace file</a>
            <a href="Gws-file.topic" summary="The line-based format, kept for compatibility.">Gws file</a>
            <a href="Hook.topic" summary="Run scripts before and after commands, per project or per system.">Hook</a>
        </secondary>

        <misc>
            <links narrow="true">
                <group>
                    <title>Project</title>
                    <a href="https://github.com/medialo/gogws" summary="Source code and issues.">GitHub repository</a>
                    <a href="https://github.com/medialo/gogws/releases/latest" summary="Download the latest release.">Latest release</a>
                </group>
            </links>
        </misc>
    </section-starting-page>
</topic>
